
import cv2
import pytesseract

def extract_text():
    cap = cv2.VideoCapture("video.mp4")

    while True:
        ret, frame = cap.read()

        if not ret:
            break

        gray = cv2.cvtColor(
            frame, cv2.COLOR_BGR2GRAY
        )

        text = pytesseract.image_to_string(gray)

        if text.strip():
            print("Extracted Text:")
            print(text)

        cv2.imshow("Video", frame)

        if cv2.waitKey(30) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

extract_text()

